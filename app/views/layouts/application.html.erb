<!DOCTYPE html>
<html>
  <head>
    <title><%= yield(:title) || "MMX Tagging Game" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta http-equiv="Permissions-Policy" content="interest-cohort=()">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
  
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    <link rel="icon" href="/icon.ico" type="image/png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    
    <%=stylesheet_link_tag "generalLayout.css"%>
    <%= javascript_include_tag 'application', 'data-turbo-track': 'reload', defer: true %>
    
  <ul id="navigationHeader">
    <li><%=link_to("Level select",root_path)%></li>
    <li><%=link_to("Scoreboard", scoreboard_path)%></li>
    <li><%=link_to("About",about_path)%></li>
  </ul>
  </head>
  <body>
    <div id="manageBody">
        <%= yield %>
        <div id="secondBody">
        </div>
    </div>
  </body>


<%=render "layouts/footer"%>

</html>

