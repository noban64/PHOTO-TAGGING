<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Level Select</title>
</head>
<body>
    
    <h1> Megaman Boss Finder!</h1>
    <ul>
        <%if @levels.exists? then%>
            <%@levels.each do |level| %>
                <li id="levelSelect">
                     <%=link_to "Level #{level.id}","/level/#{level.id}"%>
                </li>
            <%end%>
        <%else%>
                <p>There are no levels available right now!</p>
        <%end%>
    </ul>

    <% flash.each do |type, msg| %>
  <div>
    <%= msg %>
  </div>
<% end %>
</body>
</html>


<%=render "layouts/footer"%>