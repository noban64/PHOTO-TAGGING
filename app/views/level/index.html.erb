<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%=stylesheet_link_tag "index.css"%>
    <%content_for :title, "LEVEL SELECT" %>
</head>
<body>
    <div id="level-body">
    <h1> MEGAMAN BOSS FINDER!</h1>
    <ul>
        <%if @levels.exists? then%>
            <%@levels.each do |level| %>
                <li id="levelSelect">
                     <%=link_to "LEVEL #{level.id}","/level/#{level.id}"%>
                </li>
            <%end%>
        <%else%>
                <p>THERE ARE NO AVAILABLE LEVELS RIGHT NOW!/p>
        <%end%>
    </ul>
    </div>
    <% flash.each do |type, msg| %>
  <div>
    <%= msg.upcase %>
  </div>
<% end %>
</body>
</html>

