<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Level <%=@level.id%></title>
    <%=stylesheet_link_tag "levels.css"%>

</head>
<body>
<h1>Level <%=@level.id%></h1>

<%if @level.images.attached? then %>
  <%=image_tag @level.images.variant(:screen) %>
<%else%>
    <p>There's nothing attached!?</p>
<% end %>

<%= render "win"%>
    
</body>
</html>